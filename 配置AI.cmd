@echo off
chcp 65001 >nul
cd /d "%~dp0"
powershell.exe -NoProfile -Command "$ErrorActionPreference='Stop'; $env:PSModulePath=$PSHOME+'\Modules'; try { $s=Read-Host 'Paste your DeepSeek API key (hidden), then press Enter' -AsSecureString; if (!$s.Length) { throw 'Empty key' }; $key=[Net.NetworkCredential]::new('', $s).Password.Trim(); $body=@{model='deepseek-flash';max_tokens=180;messages=@(@{role='user';content='Reply briefly in Chinese. Suggest one gentle activity for a fictional adult with twenty minutes and a resistance band.'})} | ConvertTo-Json -Depth 5; $reply=Invoke-RestMethod -Method Post -Uri 'https://api.deepseek.com/chat/completions' -Headers @{Authorization=('Bearer '+$key)} -ContentType 'application/json' -Body $body -TimeoutSec 90; $answer=$reply.choices[0].message.content; if([string]::IsNullOrWhiteSpace($answer)){throw 'Empty reply'}; $dir=Join-Path $env:LOCALAPPDATA 'Fitplan'; [IO.Directory]::CreateDirectory($dir) | Out-Null; $enc=ConvertFrom-SecureString (ConvertTo-SecureString $key -AsPlainText -Force); $file=Join-Path $dir 'deepseek.credential'; $tmp=Join-Path $dir ([guid]::NewGuid().ToString()); [IO.File]::WriteAllText($tmp,$enc); if([IO.File]::Exists($file)){[IO.File]::Replace($tmp,$file,$null)}else{[IO.File]::Move($tmp,$file)}; Write-Host 'Connected. Real model reply:'; Write-Host $answer } catch { $r=$_.Exception.Response; if($r){Write-Host ('Provider HTTP '+[int]$r.StatusCode+' (401: check key; 402: check balance; 429: try later).')}else{Write-Host 'Setup did not finish. Check the connection and try again.'}; exit 1 }"
pause
